# Copy to .env and edit. Nothing secret goes in this file (the SSH key lives in ./ssh/).

# Address people use in the browser (must match the NPM host and the certificate).
PUBLIC_URL=https://guides-admin.kcc.com
# Login portal people are sent to when not signed in.
AUTH_PORTAL_URL=https://auth.kcc.com
# Authelia as reachable from this container (docker02 host IP + port).
AUTHELIA_URL=http://192.168.50.9:9091

# The private GitHub repo with the guides. Over port 443 because outbound 22 is blocked.
REPO_URL=ssh://git@ssh.github.com:443/OWNER/REPO.git
GIT_SSH_COMMAND=ssh -i /home/guides/.ssh/id_ed25519 -o UserKnownHostsFile=/home/guides/.ssh/known_hosts -o StrictHostKeyChecking=yes -o IdentitiesOnly=yes
REPO_BRANCH=main

# Administrators: AD sign-in names (comma separated), and/or an Authelia group.
ADMIN_USERS=a242775
ADMIN_GROUP=IT-Staff

GUIDES_SITE_URL=https://guides.kcc.com
TIMEZONE=Indian/Maldives
